# Origin của backend Laravel (KHÔNG kèm /api)
# Local: http://localhost:8000
# Production: https://api-xegheptuyen-production-qdbif7.laravel.cloud
VITE_API_BASE_URL=https://api-xegheptuyen-production-qdbif7.laravel.cloud

VITE_APP_NAME=XeGhep

# Mapbox (public token — pk.* là token công khai theo thiết kế)
VITE_MAPBOX_TOKEN=

# Laravel Reverb WebSocket (bỏ trống VITE_REVERB_APP_KEY để tắt realtime)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
