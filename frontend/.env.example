# Origin của backend Laravel (KHÔNG kèm /api)
# Local: http://localhost:8000 — Production: https://api.<domain>
VITE_API_BASE_URL=http://localhost:8000

VITE_APP_NAME=XeGhep

# Mapbox (public token — pk.* là token công khai theo thiết kế)
VITE_MAPBOX_TOKEN=

# Laravel Reverb WebSocket (bỏ trống VITE_REVERB_APP_KEY để tắt realtime)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
